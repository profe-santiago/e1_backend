# URL del backend Spring Boot.
# Vacío (recomendado en desarrollo) = las llamadas van a "/api/..." en el mismo origen y el proxy /api
# de Vite (vite.config.js) las reenvía al backend. Así funciona desde la PC y desde el celular
# (http://<ip-local>:5173 o el túnel), donde "localhost" sería el propio teléfono.
# Solo pon una URL absoluta si el frontend se sirve sin el proxy de Vite (p. ej. un build desplegado).
VITE_API_URL=

# Muestra el ítem "IA Chat" en el menú (el código del chatbot sigue en la app). Por defecto oculto.
VITE_SHOW_CHAT=false
