# Base de datos
DB_NAME=MVPClinica
DB_USER=postgres
DB_PASSWORD=tu_password_postgres

# Auth RS256 — clave publica PEM del AuthService de InToGlobe (una sola linea, sin headers)
AUTH_PUBLIC_KEY=tu_clave_publica_rsa_base64
AUTH_SERVICE_URL=http://localhost:4001

# IA - obten tu clave en https://console.groq.com
GROQ_API_KEY=tu_groq_api_key

# RabbitMQ — broker de mensajería para eventos de onboarding
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# NotifService (InToGlobe) — microservicio de notificaciones
NOTIF_SERVICE_URL=http://localhost:4002

# AuditService (InToGlobe) — dejar vacío para deshabilitar sin romper el arranque
AUDIT_SERVICE_URL=
