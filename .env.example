# Base de datos
DB_NAME=MVPClinica
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
# Puerto del host para postgres en docker compose (cambiar si 5432 ya esta ocupado)
DB_HOST_PORT=5432

# Auth RS256 — clave publica PEM en una sola linea (headers opcionales).
# Produccion: la del AuthService de InToGlobe. Local (AUTH_MODE=local): contenido de dev-public.pem.
AUTH_PUBLIC_KEY=tu_clave_publica_rsa_base64
AUTH_SERVICE_URL=http://localhost:4001

# IA - obten tu clave en https://console.groq.com
GROQ_API_KEY=tu_groq_api_key

# RabbitMQ — broker de mensajería para eventos de onboarding
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# NotifService (InToGlobe) — microservicio de notificaciones
NOTIF_SERVICE_URL=http://localhost:4002

# AuditService (InToGlobe) — dejar vacío para deshabilitar sin romper el arranque
AUDIT_SERVICE_URL=

# WhatsApp — enlace | simulado | twilio | meta | intoglobe (ver application-example.properties)
# enlace: abre WhatsApp (wa.me) con el recordatorio y un enlace para confirmar/cancelar sin login
NOTIF_PROVIDER=enlace
# URL pública del frontend que se manda en el enlace (/c/{token}), sin "/" final.
# Wi-Fi: http://<tu-ip-local>:5173   Túnel: https://<algo>.trycloudflare.com
APP_PUBLIC_URL=
# Orígenes CORS extra separados por comas, sin "/" final (APP_PUBLIC_URL y localhost:5173 ya se permiten).
# Ej.: https://<algo>.trycloudflare.com
APP_CORS_EXTRA_ORIGINS=
# Twilio sandbox (no subir valores reales)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
# URL pública exacta registrada en Twilio: https://<tunel>/api/whatsapp/twilio
TWILIO_WEBHOOK_URL=
TWILIO_JOB_ENABLED=false
# Meta WhatsApp Cloud API
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_TEMPLATE_RECORDATORIO=recordatorio_cita
WHATSAPP_META_TEMPLATE_LANG=es_MX

# Demo (scripts/demo_ana.py): teléfono de 10 dígitos al que se envía el recordatorio de la paciente demo.
# No lo subas con valor; también se puede pasar con --telefono.
DEMO_TELEFONO=
